# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Dashboard > Connect > copy the connection string (pooled is fine)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Voyage AI embeddings: dashboard.voyageai.com > API keys
VOYAGE_API_KEY=

# LLM for tagging and reranking. Set ONE of these.
# Google Gemini (free tier): aistudio.google.com > Get API key
GEMINI_API_KEY=
# Anthropic Claude (paid): console.anthropic.com > API keys
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini            # or anthropic; default picks whichever key is set
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5-5
# VOYAGE_MODEL=voyage-3.5
